[Unit]
Description=cambrian-perception -- evolutionary vision organism
# After a boot, wait for the network to be up (its chosen stream is on the
# web; sandbox.source_failed also never counts a failure with no network).
Wants=network-online.target
After=network-online.target
PartOf=cambrian.target

[Service]
Type=simple
User=cambrian
WorkingDirectory=/srv/cambrian/cambrian-perception
# One long process (a 2026-09-29 panel): no --seconds bound. It saves every
# 10 minutes and on stop; a clean exit is a reconfiguration (a video chosen)
# and systemd starts it again.
# Autostart off (docs/suite.md): skipped at boot unless `cambrian --start`
# ran this boot -- a skip, not a failure, so Restart= doesn't loop it
ExecCondition=/srv/cambrian/cambrian-perception/.venv/bin/python tools/suite.py --may-start
ExecStart=/srv/cambrian/cambrian-perception/.venv/bin/python run_vision.py /dev/video0

# Real, hard resource caps: this must not interfere with other
# workloads sharing the host. Conservative
# on purpose (8 real cores, ~7.6GB RAM total, other real workloads
# share this box) -- loosen only after watching real headroom over
# time, not upfront.
CPUQuota=150%
# Its cgroup is its own to split (run_vision.py _split_body_and_workers):
# body/ with its memory protected, workers/ at the idle scheduling class.
Delegate=yes
# Memory: set by the resource handler from what the host has (MemoryHigh =
# what it holds + what the host can spare above its strain line; MemoryMax =
# the host's RAM less that line). This MemoryMax guards only until its first run.
MemoryMax=1536M

# Its watchdog (run_vision.py _Watchdog): it tells systemd it is alive only
# while its body lives and its main loop progresses; silent this long (the
# feed's own stall line), systemd ends it and starts it again.
WatchdogSec=30
NotifyAccess=main
# One long process: it saves every 10 minutes and on stop. A clean exit is a
# reconfiguration (a video chosen to or from its camera) and a crash is a
# crash; either way systemd starts it again, resuming from its checkpoint.
Restart=always
RestartSec=10

[Install]
WantedBy=cambrian.target
