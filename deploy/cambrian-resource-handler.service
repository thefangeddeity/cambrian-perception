[Unit]
Description=cambrian-perception -- resource handler (hunger/disgust/extinction), one-shot
After=cambrian-perception.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/cambrian/cambrian-perception
ExecStart=/srv/cambrian/cambrian-perception/.venv/bin/python tools/resource_handler.py

# Needs to call `systemctl set-property` on cambrian-perception.service
# -- real, minimal privilege for exactly that, via sudoers (see deploy
# notes), not run as root.
