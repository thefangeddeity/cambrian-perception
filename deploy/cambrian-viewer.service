[Unit]
Description=cambrian-perception -- small live viewer
After=network.target

[Service]
Type=simple
User=cambrian
WorkingDirectory=/srv/cambrian/cambrian-perception
ExecStart=/srv/cambrian/cambrian-perception/.venv/bin/python tools/viewer.py --port 8090
Restart=always
RestartSec=5

# Negligible resource use (stdlib http.server, polls a small JSON
# file) -- no quota needed, unlike the evolution service itself.

[Install]
WantedBy=multi-user.target
